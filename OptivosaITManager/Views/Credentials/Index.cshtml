@model IEnumerable<Credential>
@{
    ViewData["Title"] = "Credenciales";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Credenciales</h3>
    @if (User.IsInRole(Roles.Administrador))
    {
        <a class="btn btn-primary" asp-action="Create">Nueva credencial</a>
    }
</div>

<form method="get" class="table-toolbar card-panel">
    <select name="typeFilter" class="form-select" style="max-width:200px" onchange="this.form.submit()">
        <option value="">Todos los tipos</option>
        @foreach (var t in Enum.GetValues<CredentialType>())
        {
            <option value="@t" selected="@(t.Equals(ViewBag.TypeFilter))">@t</option>
        }
    </select>
</form>

<div class="card-panel">
    <partial name="_CredentialList" model="Model" />
    @if (!Model.Any())
    {
        <p class="text-muted small mb-0">No hay credenciales registradas.</p>
    }
</div>
