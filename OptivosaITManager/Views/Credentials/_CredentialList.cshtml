@model IEnumerable<Credential>
@{
    var canReveal = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.TecnicoIT);
}
<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
<table class="table table-sm align-middle">
    <thead><tr><th>Nombre</th><th>Tipo</th><th>Usuario</th><th>Contraseña</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.CredentialType</td>
                <td>@c.Username</td>
                <td><span class="password-mask" data-password-slot="@c.Id">••••••••</span></td>
                <td class="text-end">
                    @if (canReveal)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-reveal-credential="@c.Id">Mostrar contraseña</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-credential="@c.Id">Copiar</button>
                    }
                    @if (User.IsInRole(Roles.Administrador))
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Credentials" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
