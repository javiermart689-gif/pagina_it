@model IEnumerable<EmailAccount>
@{
    ViewData["Title"] = "Cuentas de correo";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Cuentas de correo</h3>
    @if (User.IsInRole(Roles.SistemasTI))
    {
        <a class="btn btn-primary" asp-action="Create">Nueva cuenta</a>
    }
</div>

<form method="get" class="table-toolbar card-panel">
    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" style="max-width:300px" placeholder="Correo o usuario..." />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<div class="card-panel">
    <table class="table table-hover align-middle">
        <thead><tr><th>Correo</th><th>Usuario</th><th>Empleado</th><th>Tipo</th><th>Licencia</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@e.Id">@e.Email</a></td>
                    <td>@e.Username</td>
                    <td>@(e.Employee != null ? e.Employee.FirstName + " " + e.Employee.LastName : "-")</td>
                    <td>@e.AccountType</td>
                    <td>@(e.License ?? "-")</td>
                    <td><span class="badge @(e.Status == EmailAccountStatus.Activa ? "bg-success text-white" : "bg-secondary text-white")">@e.Status</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@e.Id">Ver</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No hay cuentas de correo registradas.</td></tr>
            }
        </tbody>
    </table>
</div>
