@model SearchResultViewModel
@{
    ViewData["Title"] = "Buscar";
}
<h3 class="mb-1">Buscar persona o equipo</h3>
<p class="text-muted small mb-3">Resultados para: "@ViewBag.Term"</p>

<h6 class="mb-2">Personas</h6>
@if (!Model.Employees.Any())
{
    <p class="text-muted small">Sin resultados de personas.</p>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var e in Model.Employees)
        {
            <div class="col-md-4 col-lg-3">
                <a asp-controller="Employees" asp-action="Details" asp-route-id="@e.Id" class="text-decoration-none text-reset">
                    <div class="card-panel h-100">
                        @if (!string.IsNullOrEmpty(e.AssignedDeviceInventoryNumber))
                        {
                            <div class="text-muted small text-uppercase">@e.AssignedDeviceInventoryNumber</div>
                        }
                        <div class="fw-semibold">@e.FullName</div>
                        <div class="small text-muted">@(e.Department ?? "Sin departamento")</div>
                        <div class="small text-muted">@(e.Location ?? "Sin sucursal")</div>
                        @if (!string.IsNullOrEmpty(e.Phone))
                        {
                            <div class="small text-muted">Tel. @e.Phone</div>
                        }
                    </div>
                </a>
            </div>
        }
    </div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card-panel h-100">
            <h6>Equipos</h6>
            @if (!Model.Devices.Any())
            {
                <p class="text-muted small mb-0">Sin resultados.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var d in Model.Devices)
                    {
                        <li class="mb-2">
                            <a asp-controller="Devices" asp-action="Details" asp-route-id="@d.Id">@d.Title</a><br />
                            <small class="text-muted">@d.InventoryNumber &middot; @d.Status</small>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-panel h-100">
            <h6>Correo</h6>
            @if (!Model.Emails.Any())
            {
                <p class="text-muted small mb-0">Sin resultados.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var e in Model.Emails)
                    {
                        <li class="mb-2">
                            <a asp-controller="EmailAccounts" asp-action="Details" asp-route-id="@e.Id">@e.Email</a><br />
                            <small class="text-muted">@e.EmployeeName</small>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
