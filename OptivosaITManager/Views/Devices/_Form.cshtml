@model DeviceFormViewModel

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="InventoryNumber" class="form-label"></label>
        <input asp-for="InventoryNumber" class="form-control" />
        <span asp-validation-for="InventoryNumber" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DeviceType" class="form-label"></label>
        <select asp-for="DeviceType" class="form-select" asp-items="Html.GetEnumSelectList<DeviceType>()"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<DeviceStatus>()"></select>
    </div>

    <div class="col-md-4">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" />
    </div>

    <div class="col-md-4">
        <label asp-for="ComputerName" class="form-label"></label>
        <input asp-for="ComputerName" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="OperatingSystem" class="form-label"></label>
        <input asp-for="OperatingSystem" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" class="form-select" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))">
            <option value="">-- Sin asignar --</option>
        </select>
    </div>

    <div class="col-md-4">
        <label asp-for="LocationId" class="form-label"></label>
        <select asp-for="LocationId" class="form-select" asp-items="@(new SelectList(Model.Locations, "Id", "Name"))">
            <option value="">-- Sin asignar --</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="PurchaseDate" class="form-label"></label>
        <input asp-for="PurchaseDate" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="WarrantyExpirationDate" class="form-label"></label>
        <input asp-for="WarrantyExpirationDate" class="form-control" />
    </div>

    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>
</div>
