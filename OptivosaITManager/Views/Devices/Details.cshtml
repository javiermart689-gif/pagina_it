@model DeviceDetailViewModel
@{
    var device = Model.Device;
    ViewData["Title"] = $"{device.InventoryNumber}";
    var current = Model.AssignmentHistory.FirstOrDefault(a => a.ReturnedAt == null);
    var canEdit = User.IsInRole(Roles.SistemasTI);
    var isBaja = device.Status == DeviceStatus.Baja;
    var openMaintenance = Model.MaintenanceHistory.FirstOrDefault(m => m.CompletedAt == null);
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-0">@device.Brand @device.Model</h3>
        <div class="text-muted">Inventario: @device.InventoryNumber &middot; Serie: @device.SerialNumber &middot; Hostname: @device.ComputerName</div>
    </div>
    <div>
        @if (canEdit && !isBaja)
        {
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@device.Id">Editar</a>
            <form asp-action="Deactivate" asp-route-id="@device.Id" method="post" class="d-inline"
                  onsubmit="return confirm('¿Confirma dar de baja este equipo?');">
                <button type="submit" class="btn btn-outline-danger">Dar de baja</button>
            </form>
        }
    </div>
</div>

@if (isBaja)
{
    <div class="alert alert-secondary">Este equipo está dado de baja. Solo puede consultarse su información e historial.</div>
}

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card-panel h-100">
            <h6>Estado y ubicación</h6>
            <p class="mb-1"><strong>Estado:</strong> <span class="badge bg-primary text-white">@device.Status</span></p>
            <p class="mb-1"><strong>Tipo:</strong> @device.DeviceType</p>
            <p class="mb-1"><strong>Sistema operativo:</strong> @device.OperatingSystem</p>
            <p class="mb-1"><strong>Departamento:</strong> @device.Department?.Name</p>
            <p class="mb-1"><strong>Ubicación:</strong> @device.Location?.Name</p>
            <p class="mb-0"><strong>Garantía hasta:</strong> @(device.WarrantyExpirationDate?.ToString("dd/MM/yyyy") ?? "N/D")</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-panel h-100">
            <h6>Usuario actual</h6>
            @if (current != null)
            {
                <p class="mb-1">
                    <strong><a asp-controller="Employees" asp-action="Details" asp-route-id="@current.Employee.Id">@current.Employee.FirstName @current.Employee.LastName</a></strong>
                </p>
                <p class="mb-1 text-muted">@current.Employee.Department?.Name &middot; @(current.Employee.Location?.Name ?? "Sin sucursal")</p>
                <p class="mb-1 text-muted">Tel. @(current.Employee.Phone ?? "-")</p>
                <p class="mb-2 text-muted small">Asignado desde @current.AssignedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                @if (canEdit && device.Status == DeviceStatus.Asignado)
                {
                    <a class="btn btn-sm btn-primary" asp-controller="Assignments" asp-action="Reassign" asp-route-deviceId="@device.Id">Reasignar equipo</a>
                    <form asp-controller="Assignments" asp-action="Return" asp-route-deviceId="@device.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Confirma la devolución de este equipo? Quedará disponible para asignarse a otra persona.');">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Devolver equipo</button>
                    </form>
                }
            }
            else
            {
                <p class="text-muted mb-2">Este equipo no tiene un usuario asignado actualmente.</p>
                @if (canEdit && device.Status == DeviceStatus.Disponible)
                {
                    <a class="btn btn-sm btn-primary" asp-controller="Assignments" asp-action="Assign" asp-route-deviceId="@device.Id">Asignar equipo</a>
                }
            }
            @if (canEdit && device.Status == DeviceStatus.Mantenimiento)
            {
                <div class="mt-2">
                    @if (openMaintenance is not null)
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Maintenance" asp-action="Edit" asp-route-id="@openMaintenance.Id">Finalizar mantenimiento</a>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Maintenance" asp-action="Create" asp-route-deviceId="@device.Id">Registrar mantenimiento</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="card-panel mb-3">
    <h6 class="mb-2">Código QR del equipo</h6>
    @if (device.QrToken is null)
    {
        <p class="text-muted small mb-2">Este equipo todavía no tiene un código QR. El QR identifica al equipo de forma permanente: seguirá funcionando aunque se reasigne a otra persona.</p>
        @if (canEdit && !isBaja)
        {
            <form asp-action="GenerateQr" asp-route-id="@device.Id" method="post">
                <button type="submit" class="btn btn-primary">Generar QR</button>
            </form>
        }
    }
    else
    {
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="qr-image" style="width:140px;height:140px">@Html.Raw(Model.QrSvg)</div>
            <div>
                <p class="mb-2 text-muted small">Al escanearlo, un usuario autenticado con permisos de TI ve automáticamente la ficha actual de este equipo (persona asignada, departamento, sucursal y cuentas), sin importar cuántas veces cambie de dueño.</p>
                <a class="btn btn-outline-primary" asp-action="Label" asp-route-id="@device.Id" target="_blank">Descargar / imprimir etiqueta</a>
            </div>
        </div>
    }
</div>

<div class="card-panel mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">🔐 Accesos relacionados</h6>
        @if (canEdit && !isBaja)
        {
            <a class="btn btn-sm btn-outline-primary" asp-controller="Accesses" asp-action="Create" asp-route-deviceId="@device.Id">+ Nuevo acceso</a>
        }
    </div>
    @if (!Model.CanViewCredentials)
    {
        <p class="text-muted small mb-0">Los accesos de este equipo requieren permisos de Sistemas / TI.</p>
    }
    else if (!Model.Accesses.Any())
    {
        <p class="text-muted small mb-0">No hay accesos registrados para este equipo.</p>
    }
    else
    {
        <partial name="../Accesses/_AccessList" model="Model.Accesses" />
    }
</div>

<div class="card-panel mb-3">
    <h6>Historial de asignaciones</h6>
    @if (!Model.AssignmentHistory.Any())
    {
        <p class="text-muted small mb-0">Sin historial de asignaciones.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>Desde</th><th>Hasta</th><th>Usuario</th><th>Departamento</th><th>Notas</th></tr></thead>
            <tbody>
                @foreach (var a in Model.AssignmentHistory)
                {
                    <tr>
                        <td>@a.AssignedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@(a.ReturnedAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Activo")</td>
                        <td>@a.Employee.FirstName @a.Employee.LastName</td>
                        <td>@a.Employee.Department?.Name</td>
                        <td>@a.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card-panel">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Historial de mantenimiento</h6>
        @if (canEdit && !isBaja && device.Status != DeviceStatus.Mantenimiento)
        {
            <a class="btn btn-sm btn-outline-primary" asp-controller="Maintenance" asp-action="Create" asp-route-deviceId="@device.Id">Registrar mantenimiento</a>
        }
    </div>
    @if (!Model.MaintenanceHistory.Any())
    {
        <p class="text-muted small mb-0">Sin registros de mantenimiento.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>Reportado</th><th>Problema</th><th>Estado</th><th>Completado</th></tr></thead>
            <tbody>
                @foreach (var m in Model.MaintenanceHistory)
                {
                    <tr>
                        <td>@m.ReportedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@m.Problem</td>
                        <td><span class="badge bg-info text-dark">@m.Status</span></td>
                        <td>@(m.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
