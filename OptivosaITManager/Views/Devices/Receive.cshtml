@model DeviceReceiveViewModel
@{
    ViewData["Title"] = "Recibir equipo";
}
<h3 class="mb-3">Recibir equipo</h3>

<form method="get" class="table-toolbar card-panel">
    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" style="max-width:320px"
           placeholder="Número de inventario o serie (o escanee el QR del equipo)" autofocus />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

@if (Model.Device is null)
{
    <p class="text-muted small">Busque un equipo por su número de inventario o de serie, o escanee su código QR para abrir directamente su ficha y usar el botón "Recibir equipo".</p>
}
else
{
    var device = Model.Device;
    <div class="card-panel mb-3">
        <div class="row g-2">
            <div class="col-md-3"><strong>Equipo:</strong> <a asp-action="Details" asp-route-id="@device.Id">@device.InventoryNumber</a></div>
            <div class="col-md-3"><strong>Modelo:</strong> @device.Brand @device.Model</div>
            <div class="col-md-3"><strong>Departamento:</strong> @(device.Department?.Name ?? "-")</div>
            <div class="col-md-3"><strong>Sucursal:</strong> @(device.Location?.Name ?? "-")</div>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-md-6">
                <strong>Persona asignada:</strong>
                @if (Model.CurrentAssignment != null)
                {
                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.CurrentAssignment.Employee.Id">
                        @Model.CurrentAssignment.Employee.FirstName @Model.CurrentAssignment.Employee.LastName
                    </a>
                    <span class="text-muted">(@Model.CurrentAssignment.Employee.Department?.Name)</span>
                }
                else
                {
                    <span class="text-muted">Sin usuario asignado</span>
                }
            </div>
            <div class="col-md-6">
                <strong>Estado actual:</strong> <span class="badge bg-primary text-white">@device.Status</span>
            </div>
        </div>
    </div>

    <div class="card-panel" style="max-width:500px">
        <h6 class="mb-3">Registrar recepción</h6>
        <form asp-action="ReceiveConfirm" method="post">
            <input type="hidden" name="deviceId" value="@device.Id" />
            <div class="mb-3">
                <label class="form-label">Nuevo estado</label>
                <select name="newStatus" class="form-select" asp-for="NewStatus"
                        asp-items="@(new SelectList(DeviceReceiveViewModel.AllowedStatuses, Model.NewStatus))"></select>
            </div>
            <div class="mb-3">
                <label class="form-label">Notas</label>
                <textarea name="notes" class="form-control" rows="2" placeholder="Observaciones sobre el estado físico del equipo, motivo, etc."></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Confirmar recepción</button>
        </form>
    </div>
}
