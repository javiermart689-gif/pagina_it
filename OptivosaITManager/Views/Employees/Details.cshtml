@model EmployeeDetailViewModel
@{
    var employee = Model.Employee;
    ViewData["Title"] = $"{employee.FirstName} {employee.LastName}";
    var canEdit = User.IsInRole(Roles.SistemasTI);
}
<form>@Html.AntiForgeryToken()</form>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-0">@employee.FullName</h3>
        <div class="text-muted">@employee.Position &middot; @employee.Department?.Name &middot; @employee.EmployeeNumber</div>
    </div>
    @if (canEdit)
    {
        <div>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@employee.Id">Editar</a>
            @if (employee.Status == EmployeeStatus.Activo)
            {
                <form asp-action="Deactivate" asp-route-id="@employee.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Confirma desactivar este usuario?');">
                    <button type="submit" class="btn btn-outline-danger">Desactivar</button>
                </form>
            }
        </div>
    }
</div>

<div class="card-panel mb-3">
    <h6>Información general</h6>
    <div class="row g-2">
        <div class="col-md-3"><strong>Nombre:</strong> @employee.FullName</div>
        <div class="col-md-3"><strong>Departamento:</strong> @(employee.Department?.Name ?? "-")</div>
        <div class="col-md-3"><strong>Sucursal:</strong> @(employee.Location?.Name ?? "-")</div>
        <div class="col-md-3"><strong>Teléfono:</strong> @(employee.Phone ?? "-")</div>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-md-3"><strong>Correo:</strong> @employee.Email</div>
        <div class="col-md-3"><strong>Extensión:</strong> @(employee.Extension ?? "-")</div>
        <div class="col-md-6">
            <strong>Estado:</strong>
            <span class="badge @(employee.Status == EmployeeStatus.Activo ? "bg-success text-white" : "bg-secondary text-white")">@employee.Status</span>
        </div>
    </div>
</div>

@* ===================== Equipo asignado ===================== *@
<div class="card-panel mb-3">
    <h6 class="mb-2">Equipo asignado</h6>
    @if (!Model.AssignedDevices.Any())
    {
        <p class="text-muted small mb-0">
            Esta persona no tiene un equipo asignado actualmente.
            <a asp-controller="Devices" asp-action="Index">Ver equipos disponibles</a>.
        </p>
    }
    else
    {
        foreach (var info in Model.AssignedDevices)
        {
            <div class="mb-2 pb-2 border-bottom">
                <p class="mb-1">
                    <strong>Equipo:</strong>
                    <a asp-controller="Devices" asp-action="Details" asp-route-id="@info.Device.Id">@info.Device.InventoryNumber</a>
                    &mdash; @info.Device.Brand @info.Device.Model
                </p>
                <p class="mb-0 text-muted small">
                    Tipo: @info.Device.DeviceType &middot; Hostname: @info.Device.ComputerName
                    &middot; <a asp-controller="Devices" asp-action="Details" asp-route-id="@info.Device.Id">Ver accesos de este equipo</a>
                </p>
            </div>
        }
    }
</div>

@* ===================== Accesos ===================== *@
<div class="card-panel">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">🔐 Accesos</h6>
        @if (canEdit)
        {
            <a class="btn btn-sm btn-outline-primary" asp-controller="Accesses" asp-action="Create"
               asp-route-employeeId="@employee.Id">+ Nuevo acceso</a>
        }
    </div>
    @if (!Model.CanViewCredentials)
    {
        <p class="text-muted small mb-0">Los accesos de esta persona requieren permisos de Sistemas / TI.</p>
    }
    else if (!Model.Accesses.Any())
    {
        <p class="text-muted small mb-0">Sin accesos registrados (correo, sistemas, VPN, etc.).</p>
    }
    else
    {
        <partial name="../Accesses/_AccessList" model="Model.Accesses" />
    }
</div>
