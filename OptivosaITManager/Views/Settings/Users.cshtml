@model IEnumerable<UserListItemViewModel>
@{
    ViewData["Title"] = "Usuarios del sistema";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Usuarios del sistema</h3>
    <a class="btn btn-primary" asp-action="CreateUser">Nuevo usuario</a>
</div>
<div class="card-panel">
    <table class="table table-hover align-middle">
        <thead><tr><th>Correo</th><th>Nombre</th><th>Roles</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Email</td>
                    <td>@u.DisplayName</td>
                    <td>@string.Join(", ", u.Roles.Select(Roles.DisplayName))</td>
                    <td>
                        @if (u.LockedOut)
                        {
                            <span class="badge bg-danger text-white">Bloqueado</span>
                        }
                        else
                        {
                            <span class="badge bg-success text-white">Activo</span>
                        }
                    </td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="EditUserRoles" asp-route-id="@u.Id">Editar roles</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
