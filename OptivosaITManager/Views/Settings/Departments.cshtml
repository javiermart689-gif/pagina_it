@model IEnumerable<Department>
@{
    ViewData["Title"] = "Departamentos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Departamentos</h3>
    <a class="btn btn-primary" asp-action="DepartmentCreate">Nuevo departamento</a>
</div>
<div class="card-panel">
    <table class="table table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Name</td>
                    <td>@d.Description</td>
                    <td><span class="badge @(d.IsActive ? "bg-success text-white" : "bg-secondary text-white")">@(d.IsActive ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="DepartmentEdit" asp-route-id="@d.Id">Editar</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
